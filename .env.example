# ── Firebase ──────────────────────────────────────────────────────────────────
# Get these values from your Firebase project settings:
# https://console.firebase.google.com → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com/
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ── Super Admin ────────────────────────────────────────────────────────────────
# Credentials for the seeded super-admin account
VITE_SUPERADMIN_EMAIL=superadmin@yourdomain.com
VITE_SUPERADMIN_PASSWORD=your_strong_password

# ── Cloudinary (profile picture uploads) ──────────────────────────────────────
# 1. Create a free account at https://cloudinary.com
# 2. Your cloud name is shown on the Cloudinary dashboard
# 3. Create an *unsigned* upload preset:
#    Settings → Upload → Upload presets → Add upload preset
#    Set "Signing Mode" to "Unsigned" and save the preset name below
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
